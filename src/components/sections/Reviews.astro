---
import "./Reviews.css";
import ReviewCard from "../cards/ReviewCard.astro";
import { reviews } from "../../data/site";
---

<section class="section reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="reviews__head">
    <h2 class="section__title reviews__title" id="reviews-title">
      Дізнайтеся, чому пацієнти довіряють нам
    </h2>
    <p class="reviews__more">
      Більше відгуків
      <img src="/icons/arrow.svg" width="35" height="35" alt="" />
    </p>
  </div>
  <div class="reviews__grid">
    {reviews.map((review) => <ReviewCard {...review} />)}
  </div>
</section>
